<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with the same certificate (our own copies across
         profiles) may trigger a clone. v2.2 hardening. -->
    <permission
        android:name="com.shina.dualspace.permission.TRIGGER_CLONE"
        android:label="Trigger Shina Dual clone"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="com.shina.dualspace.permission.TRIGGER_CLONE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Shina Dual Space"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/Theme.ShinaDualSpace">

        <!-- Launcher only. No CLONE intent-filter here anymore: an exported
             launcher activity must not be a clone trigger. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sole clone entry point: signature-protected + user confirmation. -->
        <activity
            android:name=".CloneActivity"
            android:exported="true"
            android:permission="com.shina.dualspace.permission.TRIGGER_CLONE"
            android:theme="@style/Theme.ShinaDualSpace">
            <intent-filter>
                <action android:name="com.shina.dualspace.CLONE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DualAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
